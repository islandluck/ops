# ---------------------------------------------------------------------------
# Operator — environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase Postgres (Database → Connect → ORMs, in your Supabase project) ---
# Pooled connection (port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) — used by migrations:
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Scheduler / cron (auto-publish + background agents) ---
# Shared secret the cron routes (/api/agents/run, /api/social/publish) require.
# Vercel Cron sends it as a Bearer token; set the same value in Vercel env vars.
# REQUIRED in production for scheduled posts to auto-publish. Generate one with
# `openssl rand -base64 24`. Without it, the cron endpoints reject every request.
# CRON_SECRET=""

# --- Execution safety (autopilot guardrails) ---
# Global KILL SWITCH: set to 1 to instantly halt ALL task execution (attended and
# unattended) — the big red button. Leave unset/0 for normal operation.
# OPERATOR_EXECUTION_DISABLED="0"
# Per-workspace daily cap on UNATTENDED (auto-mode / cron) executions, to bound a
# runaway agent. Human-approved actions are never capped. Defaults to 50.
# OPERATOR_DAILY_ACTION_CAP="50"

# --- Auth (testing only) ---
# When "true", new sign-ups are auto-confirmed via the service role and signed in
# immediately (no email confirmation). Use ONLY for local/dev testing so signup is
# exercisable without email delivery. Leave OFF in production — configure custom
# SMTP in Supabase (Auth → Emails) and require real email confirmation instead.
# AUTH_AUTOCONFIRM="true"

# --- AI drafting (Anthropic) — enables agents to draft & revise real content ---
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-opus-4-8):
# ANTHROPIC_MODEL="claude-opus-4-8"

# --- Live research (Tavily) — the Social Media Agent uses this for current topics ---
# Free tier at tavily.com. Without it, the agent drafts from the business brief only.
# TAVILY_API_KEY="tvly-..."

# --- Stock photos (Pexels) — the image picker's stock library ---
# Free API key at pexels.com/api. Without it, uploads still work; only stock
# search is disabled.
# PEXELS_API_KEY="..."

# --- Live integrations (Phase 3) — see PHASE3.md for how to create each app ---
# Required to store OAuth tokens (generate: `openssl rand -base64 32`):
# TOKEN_ENCRYPTION_KEY=""
# Google (Gmail send + Calendar + Sheets) — one OAuth app powers all three:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# HubSpot (CRM contacts):
# HUBSPOT_CLIENT_ID=""
# HUBSPOT_CLIENT_SECRET=""
# Notion (create pages) — a Public OAuth integration:
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# X / Twitter (publish approved posts + images) — OAuth 2.0 confidential client.
# NOTE: image posting needs the media.write scope — if you connected X before
# images were added, reconnect it (Integrations → X → disconnect + connect) to
# grant the new permission. Text posts work either way.
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# Stripe (real Checkout for page buy buttons + draft invoices) — use a TEST key.
# Get a test key at dashboard.stripe.com (toggle "Test mode") → Developers → API keys.
# STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret to mark orders paid. Local: run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and copy the whsec_… it prints. Prod: add a
# webhook endpoint for checkout.session.completed and copy its signing secret.
# STRIPE_WEBHOOK_SECRET="whsec_..."
