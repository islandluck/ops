# ---------------------------------------------------------------------------
# Operator — environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase Postgres (Database → Connect → ORMs, in your Supabase project) ---
# Pooled connection (port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) — used by migrations:
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Operator admin (AI usage report at /admin/usage) ---
# Comma-separated emails allowed to view the cross-tenant AI usage ranking.
# Set this to whatever account(s) you sign in with.
# ADMIN_EMAILS="you@company.com"

# --- Scheduler / cron (auto-publish + background agents) ---
# Shared secret the cron routes (/api/agents/run, /api/social/publish) require.
# Vercel Cron sends it as a Bearer token; set the same value in Vercel env vars.
# REQUIRED in production for scheduled posts to auto-publish. Generate one with
# `openssl rand -base64 24`. Without it, the cron endpoints reject every request.
# CRON_SECRET=""

# --- Execution safety (autopilot guardrails) ---
# Global KILL SWITCH: set to 1 to instantly halt ALL task execution (attended and
# unattended) — the big red button. Leave unset/0 for normal operation.
# OPERATOR_EXECUTION_DISABLED="0"
# Per-workspace daily cap on UNATTENDED (auto-mode / cron) executions, to bound a
# runaway agent. Human-approved actions are never capped. Defaults to 50.
# OPERATOR_DAILY_ACTION_CAP="50"

# --- Auth (testing only) ---
# When "true", new sign-ups are auto-confirmed via the service role and signed in
# immediately (no email confirmation). Use ONLY for local/dev testing so signup is
# exercisable without email delivery. Leave OFF in production — configure custom
# SMTP in Supabase (Auth → Emails) and require real email confirmation instead.
# AUTH_AUTOCONFIRM="true"

# --- AI drafting (Anthropic) — enables agents to draft & revise real content ---
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override — applies to EVERY AI operation. Defaults to claude-opus-4-8.
# COST LEVER: point all AI at a cheaper model here, no code change. Prices per 1M tokens:
#   claude-haiku-4-5-20251001  → $1/$5   (~80% cheaper than Opus — best for cost)
#   claude-sonnet-4-6          → $3/$15  (~40% cheaper, near-Opus quality — middle ground)
#   claude-opus-4-8            → $5/$25  (default — highest quality)
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# The Team Assistant (portal, for team members) ALWAYS runs on Haiku by default —
# the low tier — regardless of ANTHROPIC_MODEL above. Override it only if needed.
# TEAM_ASSISTANT_MODEL="claude-haiku-4-5-20251001"

# --- Live research (Tavily) — the Social Media Agent uses this for current topics ---
# Free tier at tavily.com. Without it, the agent drafts from the business brief only.
# TAVILY_API_KEY="tvly-..."

# --- Stock photos (Pexels) — the image picker's stock library ---
# Free API key at pexels.com/api. Without it, uploads still work; only stock
# search is disabled.
# PEXELS_API_KEY="..."

# --- Live integrations (Phase 3) — see PHASE3.md for how to create each app ---
# Required to store OAuth tokens (generate: `openssl rand -base64 32`):
# TOKEN_ENCRYPTION_KEY=""
# Google (Gmail send + Calendar + Sheets) — one OAuth app powers all three:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# HubSpot (CRM contacts):
# HUBSPOT_CLIENT_ID=""
# HUBSPOT_CLIENT_SECRET=""
# Notion (create pages) — a Public OAuth integration:
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# X / Twitter (publish approved posts + images) — OAuth 2.0 confidential client.
# NOTE: image posting needs the media.write scope — if you connected X before
# images were added, reconnect it (Integrations → X → disconnect + connect) to
# grant the new permission. Text posts work either way.
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# Stripe (real Checkout for page buy buttons + draft invoices) — use a TEST key.
# Get a test key at dashboard.stripe.com (toggle "Test mode") → Developers → API keys.
# STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret to mark orders paid. Local: run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and copy the whsec_… it prints. Prod: add a
# webhook endpoint for checkout.session.completed and copy its signing secret.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- X (Twitter) Ads API — deploy ads from the Ads Manager (all optional) ---
# Separate from the X posting connection above: the Ads API needs its own app
# with "Ads API access" approved, OAuth 1.0a credentials, and a FUNDED ads
# account. Until all five are set, "Publish to X" runs as a safe dry-run (it
# shows the exact campaign it would create and sends nothing). When set, publish
# creates the campaign PAUSED — it never spends until you explicitly activate it.
#   1. Create an app at developer.x.com and apply for Ads API access.
#   2. Create + fund an ads account at ads.x.com (Account ID is in the URL).
#   3. Generate the app's API key/secret and your access token/secret.
# X_ADS_CONSUMER_KEY=""      # app API key
# X_ADS_CONSUMER_SECRET=""   # app API secret
# X_ADS_ACCESS_TOKEN=""      # your user access token (with ads permissions)
# X_ADS_ACCESS_SECRET=""     # your user access token secret
# X_ADS_ACCOUNT_ID=""        # the ads account id (e.g. 18ce54d4x5t)

# --- Zoom (schedule meetings from the Executive) ---
# Create a user-managed OAuth app at marketplace.zoom.us (Develop → Build App →
# OAuth). Add the `meeting:write` scope (or `meeting:write:meeting` on granular
# apps), and set the redirect URL to `<app-url>/api/integrations/zoom/callback`.
# Then connect it in Integrations. Until set, "Connect Zoom" shows "not configured".
# ZOOM_CLIENT_ID=""
# ZOOM_CLIENT_SECRET=""

# --- Slack (notifications + Executive post_to_slack) ---
# Create an app at api.slack.com/apps ("From scratch"). Under OAuth & Permissions
# add Bot Token Scopes: chat:write, chat:write.public, channels:read. Set the
# Redirect URL to `<app-url>/api/integrations/slack/callback` (Slack requires
# HTTPS — localhost is NOT allowed, so connect from your deployed URL). Copy the
# Client ID/Secret from Basic Information. SLACK_DEFAULT_CHANNEL is the channel
# notifications (e.g. the daily brief) post to — a public channel name or ID;
# defaults to "general". Until the two creds are set, "Connect Slack" shows "not configured".
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
# SLACK_DEFAULT_CHANNEL="general"
