# ---------------------------------------------------------------------------
# Operator — environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase Postgres (Database → Connect → ORMs, in your Supabase project) ---
# Pooled connection (port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) — used by migrations:
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (testing only) ---
# When "true", new sign-ups are auto-confirmed via the service role and signed in
# immediately (no email confirmation). Use ONLY for local/dev testing so signup is
# exercisable without email delivery. Leave OFF in production — configure custom
# SMTP in Supabase (Auth → Emails) and require real email confirmation instead.
# AUTH_AUTOCONFIRM="true"

# --- AI drafting (Anthropic) — enables agents to draft & revise real content ---
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-opus-4-8):
# ANTHROPIC_MODEL="claude-opus-4-8"

# --- Live integrations (Phase 3) — see PHASE3.md for how to create each app ---
# Required to store OAuth tokens (generate: `openssl rand -base64 32`):
# TOKEN_ENCRYPTION_KEY=""
# Google (Gmail send + Calendar + Sheets) — one OAuth app powers all three:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# HubSpot (CRM contacts):
# HUBSPOT_CLIENT_ID=""
# HUBSPOT_CLIENT_SECRET=""
# Notion (create pages) — a Public OAuth integration:
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# Stripe (draft invoices) — use a TEST key (sk_test_…):
# STRIPE_SECRET_KEY=""
